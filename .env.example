# Kivo deployment configuration
# Copy this file to .env on the server. Never commit the real .env file.
# The example below assumes Kivo sits behind an HTTPS reverse proxy.

KIVO_PUBLIC_URL=https://kivo.example.com
KIVO_ADMIN_EMAIL=owner@kivo.local
KIVO_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PRIVATE_PASSWORD
SECURE_COOKIES=true
KIVO_TRUST_PROXY=true
KIVO_BIND_ADDRESS=127.0.0.1

# For local HTTP-only Docker testing instead:
# KIVO_PUBLIC_URL=http://localhost:8080
# SECURE_COOKIES=false
# KIVO_TRUST_PROXY=false

# Optional cloud intelligence. Leave blank for Smart Local v2.
OPENAI_API_KEY=
KIVO_AI_MODEL=gpt-5-mini
KIVO_AI_TIMEOUT_MS=8500

# Optional Stripe billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
KIVO_PRO_MONTHLY_AUD=7.99
KIVO_PRO_YEARLY_AUD=59.99
